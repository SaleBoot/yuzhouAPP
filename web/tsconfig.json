{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "preserve", "resolveJsonModule": true,
    "esModuleInterop": true, "allowJs": true, "checkJs": false,
    "allowImportingTsExtensions": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.js", "vite.config.ts", "vite.site.config.ts"]
}
