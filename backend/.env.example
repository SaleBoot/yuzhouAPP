APP_ENV=production
APP_DEBUG=0
APP_URL=https://yuzhou.ourideas.top
VR_BASE_URL=
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yuzhou
DB_USERNAME=yuzhou
DB_PASSWORD=
DB_SQLITE_PATH=
ALLOW_TEST_PAYMENTS=0
CORS_ORIGINS=https://yuzhou.ourideas.top
TOKEN_TTL_SECONDS=604800
STORAGE_PATH=
# Dedicated Yuzhou RAM identity and approved Aliyun SMS sign/template. Disabled by default.
ALI_SMS_ENABLED=0
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
ALI_SMS_SECURITY_TOKEN=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=
ALI_SMS_CODE_PARAM=code
# Stable independent random secret, at least 32 characters. Rotation needs a controlled identity migration.
ALI_SMS_HMAC_KEY=
